# data/raw/* (children, not the directory itself) — excluding the directory
# would stop git from descending into it, which silently disables every
# whitelist below: the two long-tracked CSVs only survived because they were
# force-added before this rule existed.
data/raw/*
# ...except the hand-curated award and draft tables. _compute_max_eligible in
# train.py silently falls back to an age heuristic without them, so a clone
# that lacks these does not reproduce the published numbers.
!data/raw/raw_external/
data/raw/raw_external/*
!data/raw/raw_external/awards_full.csv
!data/raw/raw_external/player_draft_2020-2025.matched.corrected.csv
!data/raw/raw_external/early_supermax.csv
!data/raw/raw_external/designated_ineligible.csv
!data/raw/raw_external/mle_exception_amounts.csv
!data/raw/raw_external/extension_raise_caps.csv
!data/raw/raw_external/salary_corrections.csv

outputs/models/
__pycache__/
*.pyc
.env
*.egg-info/
.ipynb_checkpoints/

# Model artifact written by predict.py for the api_backend export
/xgboost_model.json

# Scratch files from scraping/debug sessions
_debug_search.html
_missing_spotrac.json

# Pre-refresh snapshot written by scripts/refresh_salaries.py for the
# structure-extension diff; transient machine state
data/processed/salaries_prev.csv

# Machine-local agent config (launch.json hardcodes an absolute path)
.claude/settings.local.json
.claude/launch.json
